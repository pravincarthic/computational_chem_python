&CONTROL
  calculation = 'relax'
  restart_mode='from_scratch'
  pseudo_dir = './pseudo/'
  outdir = './tmp/'
  nstep = 200
  prefix = 'calc'
  tprnfor = .true.
  tstress = .false.
/

&SYSTEM
  nat = 50
  ntyp = 3
  ecutwfc = 60
  ecutrho = 720
  input_dft = 'PBE'
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.005
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
  dftd3_threebody = .false.
  assume_isolated = 'mt'
  ibrav = 0
  nosym = .true.
  noinv = .true.
  noncolin = .false.
  lspinorb = .false.
/

&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  mixing_mode = 'local-TF'
  electron_maxstep = 250
/

&IONS
  ion_dynamics = 'damp'
  fire_f_inc = 1.6
  trust_radius_ini = 0.01
  trust_radius_max = 0.40
/

